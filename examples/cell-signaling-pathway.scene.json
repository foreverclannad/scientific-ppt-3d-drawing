{
  "schema_version": "0.2",
  "scene_id": "cell-signaling-pathway",
  "title": "Generic editable signaling/pathway grammar",
  "domain": "biochemistry",
  "representation": "2d",
  "fidelity": {
    "mode": "illustrative",
    "source_data": [],
