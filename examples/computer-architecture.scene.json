    },
    {
      "id": "node.proposal",
      "kind": "primitive",
      "semantic_role": "optimization",
      "geometry": {
        "shape": "rounded_rectangle",
        "left_pt": 500,
        "top_pt": 210,
        "width_pt": 150,
        "height_pt": 76,
        "depth_pt": 12
      },
      "appearance": {
        "fill": "#FCEFE7",
