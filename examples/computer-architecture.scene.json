    },
    {
      "id": "node.validation",
      "kind": "primitive",
      "semantic_role": "physical_validation",
      "geometry": {
        "shape": "rounded_rectangle",
        "left_pt": 710,
        "top_pt": 210,
        "width_pt": 150,
        "height_pt": 76,
